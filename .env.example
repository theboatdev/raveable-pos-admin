# Copy to .env.local and fill in. Never commit .env.local.
# Without Clerk keys, `pnpm dev` runs in Clerk keyless mode (temporary dev keys in .clerk/).
# Staff can sign in to the organisers' Clerk application or to a separate one for staff
# (recommended in production; then set PLATFORM_CLERK_* in the backend too). Either way,
# the API's staff list decides who gets in (backend docs/adr/0009).

# Clerk (Dashboard → API keys) for the platform-staff Clerk application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes. Staff are invited; /sign-up only completes an invitation
# (set the staff Clerk application's sign-up mode to Restricted).
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/overview
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/overview

# Raveable API (backend repo)
NEXT_PUBLIC_API_URL=http://localhost:4000
